// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Utilisateur{
  id Int @id @default(autoincrement())
  nom String
  langue String
  niveau String
  compte Compte?
  statistiques Statistiques?
  progressions ProgressionCours[]
}

model Compte{
  id Int  @id @default(autoincrement())
  email String @unique
  mot_de_passe String
  description String?
  photo_profil String?
  id_utilisateur Int @unique
  utilisateur Utilisateur @relation(fields: [id_utilisateur], references: [id])
}

model Statistiques{
  id Int @id @default(autoincrement())
  points Int @default(0)
  coursTermines Int @default(0)
  id_utilisateur Int @unique
  utilisateur Utilisateur @relation(fields: [id_utilisateur], references: [id])
}

model Cours{
  id Int @id @default(autoincrement())
  titre String
  description String
  contenu String 
  niveau String 
  langue String 
  progressions ProgressionCours[]
}

model ProgressionCours{
  id Int @id @default(autoincrement())
  termine Boolean @default(false)
  id_utilisateur Int
  id_cours Int
  utilisateur Utilisateur @relation(fields: [id_utilisateur], references: [id])
  cours Cours @relation(fields: [id_cours], references: [id])

  @@unique([id_utilisateur, id_cours])
}
