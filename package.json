{
	"name": "jetalk",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@11.8.0",
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"dev": "vite",
		"dev:server": "node --watch server/index.js",
		"build": "vite build",
		"start": "node server/index.js",
		"lint": "eslint .",
		"preview": "vite preview",
		"record": "pnpm build && pnpm preview",
		"db:generate": "prisma generate",
		"db:push": "prisma db push",
		"db:init": "node scripts/db-init.js",
		"db:seed": "node seed.js",
		"db:setup": "pnpm db:init && pnpm db:seed",
		"postinstall": "prisma generate"
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
		"@prisma/adapter-libsql": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@tailwindcss/vite": "^4.3.3",
		"axios": "^1.19.0",
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"i18next": "^26.4.1",
		"i18next-http-backend": "^4.0.2",
		"jsonwebtoken": "^9.0.3",
		"lucide-react": "^1.31.0",
		"node-edge-tts": "^1.2.10",
		"prisma": "^7.9.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-i18next": "^17.0.13",
		"react-router-dom": "^7.18.2",
		"tailwindcss": "^4.3.3",
		"vite": "^8.2.1"
	},
	"optionalDependencies": {
		"node-llama-cpp": "^3.20.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.0.0",
		"eslint": "^10.9.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.6.0",
		"vite": "^8.2.1"
	}
}
