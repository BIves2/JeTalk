# ============================================================
# JeTalk — variables d'environnement
# Copiez ce fichier en `.env` puis remplacez les valeurs.
# ============================================================

# --- Base de données ---
# En local (SQLite) :
DATABASE_URL="file:./database/dev.db"

# En production (Turso) :
# DATABASE_URL="libsql://votre-base.turso.io"
# DATABASE_AUTH_TOKEN="le-token-turso"

# Jeton de signature des sessions (obligatoire, valeur longue et aléatoire)
JWT_SECRET="remplacez-par-une-chaine-aleatoire-de-64-caracteres"

# Clé de l'API Groq (https://console.groq.com/keys)
GROQ_API=""

# --- Serveur ---
PORT=5000
NODE_ENV=development

# URL(s) du frontend autorisée(s) à appeler l'API (séparées par des virgules)
CLIENT_URL="http://localhost:5173"

# --- Frontend (optionnel) ---
# Laisser vide en production lorsque le frontend et l'API partagent le même domaine.
# En local, le frontend utilise http://localhost:5000 par défaut.
# VITE_API_URL=""
